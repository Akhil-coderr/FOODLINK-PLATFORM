PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MongoDB
# Local: mongodb://localhost:27017/foodlink
# Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/foodlink?retryWrites=true&w=majority
# Use the Atlas "Database Access" user password (NOT your Atlas account password).
MONGODB_URI=mongodb://localhost:27017/foodlink
# Optional connection tuning (defaults shown)
MONGODB_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_ATTEMPTS=3
MONGODB_RETRY_DELAY_MS=2000
# Set true to run a temporary in-memory MongoDB (data resets when the server stops)
USE_IN_MEMORY_DB=false
# Set true to automatically fall back to in-memory MongoDB if the real DB is unreachable (development only)
ALLOW_IN_MEMORY_FALLBACK=false

JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Root Administrators
ADMIN_EMAIL=admin@foodlink.org
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAILS=admin@foodlink.org

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SMTP Email Configuration (Nodemailer Password Reset & Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="FoodLink Team" <noreply@foodlink.org>

# Optional Cloudinary Media Storage (Local disk uploads will be used automatically if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
